{
  "name": "@palwashakmalik/engscript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EngScript: a structured English language with a compiler, CLI and offline browser editor",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/palwashakmalik/EngScript.git" },
  "bin": { "engscript": "bin/english.mjs", "english": "bin/english.mjs" },
  "exports": "./dist/compiler.js",
  "files": ["bin", "dist", "src", "scripts/build.mjs", "scripts/serve.mjs", "web", "extension", "docs", "examples", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "check": "node bin/english.mjs check examples/hello.eng",
    "package": "npm run test && node scripts/package.mjs"
  },
  "engines": { "node": ">=24" }
}
